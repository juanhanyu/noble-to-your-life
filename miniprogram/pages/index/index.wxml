<view class="workspace">
 <view class="row masthead"><view class="brand"><image src="/assets/icon.png"/><text>言有出处</text><text class="tagline">日常话，早有出处</text></view><text class="link small" bindtap="about">关于</text></view>
 <view class="input-heading row"><text>你想说什么？</text><view class="input-actions"><text class="link" bindtap="paste">粘贴</text><text class="muted" bindtap="clearQuery">清空</text></view></view>
 <view class="search-box"><input value="{{query}}" bindinput="input" bindconfirm="search" confirm-type="search" maxlength="120" placeholder="输入日常话，寻找真实原句"/><button class="primary" bindtap="search" loading="{{loading}}" disabled="{{loading}}">{{loading?'准备中':'查询'}}</button></view>
 <view class="examples"><text class="muted">试试</text><button wx:for="{{quickExamples}}" wx:key="*this" class="example" data-q="{{item}}" bindtap="example">{{item}}</button></view>
 <view class="row filters"><view class="tabs"><text class="{{mode==='smart'?'active':''}}" data-mode="smart" bindtap="changeMode">相近表达</text><text class="{{mode==='exact'?'active':''}}" data-mode="exact" bindtap="changeMode">原文包含</text></view><picker range="{{editions}}" range-key="name" value="{{editionIndex}}" bindchange="changeEdition" disabled="{{loading}}"><text>{{editions[editionIndex].name}} ▾</text></picker></view>
 <view class="row results-heading"><text>{{showFavorites?'我的收藏':'查询结果'}}</text><view><text class="muted status">{{loading?'正在准备…':(showFavorites?favorites.length+' 条':results.length+' 条')}}</text><text class="link" bindtap="toggleFavorites">{{showFavorites?'返回查询':'收藏'}}</text></view></view>
 <scroll-view class="result-list" scroll-y enable-flex>
  <view wx:if="{{!(showFavorites?favorites.length:results.length)}}" class="empty"><view class="quote-mark">“</view><view>{{showFavorites?'收藏的原句会留在这里':'输入一句日常话，找到它的回声'}}</view><text class="muted">{{showFavorites?'选中原句，点击下方收藏':status}}</text><text wx:if="{{!ready&&!loading}}" class="link retry" bindtap="loadEdition">重试加载</text></view>
  <view class="card {{selected.key===item.key?'selected':''}}" wx:for="{{showFavorites?favorites:results}}" wx:key="key" data-index="{{index}}" bindtap="select"><view class="row muted"><text>{{item.label}}</text><text>{{item.versionName}}</text></view><view class="quote">“{{item.snippet}}”</view><view class="row"><text class="reference">{{item.bookName}} {{item.chapter}}:{{item.verse}}</text><text class="link small">{{selected.key===item.key?'已选中 ✓':'选用此句'}}</text></view><view class="context" data-index="{{index}}" catchtap="context"><text class="muted">{{item.expanded?'收起完整经节 −':'完整经节 ＋'}}</text><view wx:if="{{item.expanded}}" class="context-text" selectable>{{item.text}}</view></view></view>
 </scroll-view>
 <view class="copy-panel"><view class="preview {{selected?'':'placeholder'}}" selectable>{{preview||'选中原句后，在这里一键复制原句与出处'}}</view><view class="copy-actions"><button class="primary copy-button" disabled="{{!selected||loading}}" bindtap="copy">复制原句与出处</button><button class="secondary" disabled="{{!selected}}" bindtap="favorite">收藏</button><button class="secondary settings-button" bindtap="toggleSettings">格式</button></view><view class="footnote">原文摘录 · 不生成经文 · 请结合上下文</view></view>
 <view wx:if="{{showSettings}}" class="overlay" bindtap="toggleSettings"><view class="settings" catchtap="noop"><view class="row"><text>引用格式</text><text class="link" bindtap="toggleSettings">完成</text></view><view class="row option"><text>引用完整经节</text><switch color="#3a553d" checked="{{whole}}" bindchange="toggleWhole"/></view><view class="row option"><text>附上译本名称</text><switch color="#3a553d" checked="{{withVersion}}" bindchange="toggleVersion"/></view><input value="{{template}}" bindinput="editTemplate" maxlength="200"/><view class="muted">可用：{text} {book} {chapter} {verse} {version}</view><view class="row settings-footer"><text class="link" bindtap="resetTemplate">恢复默认</text><button class="share" open-type="share">分享这个小玩具 ↗</button></view></view></view>
</view>